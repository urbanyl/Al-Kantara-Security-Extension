{
  "manifest_version": 3,
  "name": "Al-Kantara Security",
  "version": "1.3.1",
  "description": "Enterprise-grade zero-trust browser security extension — 50+ anti-fingerprint, anti-tracking, cipher lab, encrypted vault, live threat monitor, identity rotation, and opsec protections",
  "author": "Urbanyl",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png",
    "256": "src/assets/icons/icon256.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "browsingData",
    "cookies",
    "webNavigation",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/core/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/storage-manager.js",
        "src/core/fingerprint-spoofer.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "48": "src/assets/icons/icon48.png"
    },
    "default_title": "Al-Kantara Security"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/dashboard/dashboard.html",
        "src/assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "alks_ruleset_main",
        "enabled": true,
        "path": "src/core/rules.json"
      }
    ]
  },

  "minimum_chrome_version": "109.0.0"
}
